#!/usr/bin/env python3

import os
import sys
import random
import argparse

parser = argparse.ArgumentParser(description="Stabilizer Compiler Driver")

# Which randomizations should be run
parser.add_argument('-R', action='append', choices=['code', 'heap', 'stack', 'link'], default=[])

# Driver control arguments
parser.add_argument('-v', action='store_true')
parser.add_argument('-lang', choices=['c', 'c++', 'fortran'])
parser.add_argument('-platform', choices=['auto', 'linux', 'osx'], default='auto')

# Compiler pass-through arguments
parser.add_argument('-c', action='store_true')
parser.add_argument('-o')
parser.add_argument('-O', type=int, default=2)
parser.add_argument('-g', action='store_true')
parser.add_argument('-f', action='append', default=[])
parser.add_argument('-D', action='append', default=[])
parser.add_argument('-L', action='append', default=[])
parser.add_argument('-I', action='append', default=[])
parser.add_argument('-l', action='append', default=[])
parser.add_argument('input', nargs='+')

# Do the parse
args = parser.parse_args()

def getPlatform():
	if sys.platform.startswith('darwin'):
		return 'osx'
	elif sys.platform.startswith('linux'):
		return 'linux'
	else:
		print('Unsupported platform')
		exit(2)

def arg(flag, values):
	if not isinstance(values, list):
		values = [values]
	
	cmd = ''
	for v in values:
		if v == True:
			cmd += ' -'+flag
		elif v == False:
			pass
		else:
			cmd += ' -'+flag+v
	return cmd

if args.platform == 'auto':
	args.platform = getPlatform()

STABILIZER_HOME = os.path.dirname(__file__)

if args.platform == 'osx':
	LIBSUFFIX = 'dylib'
else:
	LIBSUFFIX = 'so'

opts = []
passes = []

args.l.append('stdc++')
#args.v = True


if 'code' in args.R:
	passes.append('lower-intrinsics')
	passes.append('function(lower-switch)')
	passes.append('lower-invoke')
	opts.append('stabilize-code')

if 'stack' in args.R:
	opts.append('stabilize-stack')

if 'heap' in args.R:
	opts.append('stabilize-heap')

if 'code' in args.R or 'heap' in args.R or 'stack' in args.R:
	args.L.append(STABILIZER_HOME)
	args.l.append('stabilizer')
	passes.append('stabilize')

def compile(input):
	if input.endswith('.o'):
		return input
	
	needsAssembly = False
	
	if args.lang == 'fortran' or input.endswith('.f') or input.endswith('.f90'):
		# Fortran uses flang-new directly for everything
		cmd = 'flang-new -c -emit-llvm'
	else:
		# Use -O0 but disable optnone so lowering passes can run
		cmd = 'clang -O0 -Xclang -disable-O0-optnone -c -emit-llvm'

	cmd += arg('o ', args.o)
	cmd += arg('g', args.g)
	cmd += arg('I', args.I)
	cmd += arg('f', args.f)
	cmd += arg('D', args.D)
	
	cmd += ' '+input
	
	if args.v:
		print(cmd)
	if os.system(cmd) != 0:
		exit(1)
	
	if needsAssembly:
		cmd = 'llvm-as -o ' + args.o + ' ' + args.o + '.s'
		if args.v:
			print(cmd)
		os.system(cmd)
	
	return args.o

def link(inputs):
	cmd = 'llvm-link -o ' + args.o + '.bc '

	if 'link' in args.R:
		random.shuffle(inputs)

	cmd += ' '.join(inputs)

	if args.v:
		print(cmd)
	os.system(cmd)
	return args.o + '.bc'

def transform(input):
	cmd = 'opt -o ' + args.o + '.opt.bc'
	cmd += ' ' + input
	
	#if args.O > 0:
	#	cmd += ' -O'+str(args.O)
	
	cmd += ' -load-pass-plugin='+STABILIZER_HOME+'/LLVMStabilizer.'+LIBSUFFIX
	
	pipeline = []
	# Run optimization first, then lowering passes to clean up switch statements
	if args.O > 0:
		pipeline.append('default<O'+str(args.O)+'>')
	
	# Add lowering passes after optimization to ensure switches are lowered
	pipeline.extend(passes)
	
	# Run lower-switch again after optimization to catch any new switches
	if 'code' in args.R:
		pipeline.append('function(lower-switch)')
	
	if len(pipeline) > 0:
		cmd += ' -passes="' + ','.join(pipeline) + '"'
	
	cmd += arg('', opts)
	
	if args.v:
		print(cmd)
	os.system(cmd)
	return args.o + '.opt.bc'

def codegen(input):
	cmd = 'llc -O0 -relocation-model=pic -frame-pointer=all'
	cmd += ' -o ' + args.o + '.s'
	cmd += ' ' + input
	
	if args.v:
		print(cmd)
	os.system(cmd)
	
	if args.lang == 'fortran':
		cmd = 'flang-new'
		cmd += ' '
	else:
		cmd = 'clang -fno-pie -no-pie '
	
	cmd += args.o + '.s'
	
	cmd += arg('o ', args.o)
	cmd += arg('f', args.f)
	cmd += arg('L', args.L)
	cmd += arg('l', args.l)
	
	if args.v:
		print(cmd)
	os.system(cmd)
	
	return args.o

# Build up program arguments
object_files = list(map(compile, args.input))

if not args.c:
	linked = link(object_files)
	transformed = transform(linked)
	codegen(transformed)

